// Módulo de regras de negócio do orçamento

function calcularMaoDeObra(horas) {
  const valorHora = 95.00;
  return horas * valorHora;
}

function calcularTotal(valorMateriais, horas) {
  const valorMaoObra = calcularMaoDeObra(horas);
  return valorMateriais + valorMaoObra;
}

function verificarDesconto(total) {
  if (total >= 1000.00) {
    return "DESCONTO DE 10%";
  } else {
    return "SEM DESCONTO";
  }
}

// Exportação dos métodos
module.exports = {
  calcularMaoDeObra,
  calcularTotal,
  verificarDesconto
};
